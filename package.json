{
  "name": "kerich-pharmaceuticals",
  "version": "1.0.0",
  "description": "Kerich Pharmaceuticals Smart Healthcare Hub — pharmacy e-commerce, prescriptions, telemedicine, delivery, and admin platform for Kenya.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage:rules"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.5.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^9.0.5",
    "stripe": "^16.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
